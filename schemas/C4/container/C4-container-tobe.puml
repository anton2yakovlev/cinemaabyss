@startuml C4_Container_ToBe
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()

title Диаграмма контейнеров системы CinemaAbyss (To-Be архитектура)

Person(user, "Пользователь", "Смотрит фильмы, управляет подписками, осуществляет платежи")

System_Boundary(cinemaabyss_system, "CinemaAbyss System") {
    Container(proxy_service, "Proxy Service (API Gateway)", "Python", "Единая точка входа, маршрутизация запросов к микросервисам")
    
    Container(users_service, "Users Service", "Python", "Управление пользователями и аутентификация")
    Container(movies_service, "Movies Service", "Go", "Управление фильмами, метаданными, жанрами, рейтингами")
    Container(payments_service, "Payments Service", "Python", "Обработка платежей пользователей")
    Container(subscriptions_service, "Subscriptions Service", "Python", "Управление подписками пользователей")
    Container(events_service, "Events Service", "Python", "Создание и обработка событий через Kafka (producer/consumer)")
    
    Container(kafka, "Message Broker", "Kafka", "Брокер сообщений для асинхронной обработки событий")
    
    ContainerDb(users_db, "Users DB", "PostgreSQL", "База данных пользователей")
    ContainerDb(movies_db, "Movies DB", "PostgreSQL", "База данных фильмов и метаданных")
    ContainerDb(payments_db, "Payments DB", "PostgreSQL", "База данных платежей")
    ContainerDb(subscriptions_db, "Subscriptions DB", "PostgreSQL", "База данных подписок")
}

Rel(user, proxy_service, "API запросы", "HTTP/REST")

Rel(proxy_service, users_service, "Управление пользователями", "HTTP/REST")
Rel(proxy_service, movies_service, "Управление фильмами", "HTTP/REST")
Rel(proxy_service, payments_service, "Управление платежами", "HTTP/REST")
Rel(proxy_service, subscriptions_service, "Управление подписками", "HTTP/REST")
Rel(proxy_service, events_service, "Создание событий", "HTTP/REST")

Rel(users_service, users_db, "Запросы к БД", "SQL")
Rel(movies_service, movies_db, "Запросы к БД", "SQL")
Rel(payments_service, payments_db, "Запросы к БД", "SQL")
Rel(subscriptions_service, subscriptions_db, "Запросы к БД", "SQL")

Rel(subscriptions_service, users_service, "Проверка пользователя", "HTTP/REST")
Rel(subscriptions_service, payments_service, "Проверка платежа", "HTTP/REST")

Rel(events_service, kafka, "Публикует события", "Kafka Protocol", "movie-events, user-events, payment-events")
Rel(kafka, events_service, "Подписка на события", "Kafka Protocol", "Обработка и логирование")

SHOW_LEGEND()

@enduml

